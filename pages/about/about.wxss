/* pages/about/about.wxss */
.about-page {
    min-height: 100vh;
    padding: 40rpx 32rpx 80rpx;
    background-color: #F7F8FA;
    box-sizing: border-box;
}

.about-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #1F2933;
    line-height: 1.4;
}

.about-meta {
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #7B8794;
    line-height: 1.6;
}

.about-card {
    margin-top: 28rpx;
    padding: 28rpx;
    background-color: #FFFFFF;
    border-radius: 18rpx;
    box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.about-card.warn {
    background-color: #FFF8EC;
    border: 1rpx solid #FFE1A8;
}

.about-card-title {
    margin-bottom: 16rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #1F2933;
}

.about-p,
.about-li {
    font-size: 26rpx;
    color: #4A5568;
    line-height: 1.8;
}

.about-p + .about-p,
.about-li + .about-li {
    margin-top: 12rpx;
}

.about-li {
    position: relative;
    padding-left: 24rpx;
}

.about-li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20rpx;
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background-color: #157658;
}

.about-footer {
    margin-top: 32rpx;
    text-align: center;
    font-size: 24rpx;
    color: #9AA5B1;
}
