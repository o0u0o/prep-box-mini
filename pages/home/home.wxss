.container {
    padding: 0 0 var(--space-md) 0;
}

/* ============= Hero 顶部品牌区 ============= */
.hero {
    position: relative;
    padding: 64rpx var(--space-lg) 40rpx;
    background: linear-gradient(165deg, #0E5C44 0%, #157658 55%, #2A9C77 100%);
    color: #FFFFFF;
    border-bottom-left-radius: 36rpx;
    border-bottom-right-radius: 36rpx;
    overflow: hidden;
}
.hero::after {
    content: '';
    position: absolute;
    right: -120rpx;
    top: -120rpx;
    width: 360rpx;
    height: 360rpx;
    background: radial-gradient(circle, rgba(255,255,255,0.10), rgba(255,255,255,0));
    pointer-events: none;
}

.hero-brand {
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 4rpx;
    opacity: 0.85;
}

.hero-title {
    margin-top: 12rpx;
    font-size: 56rpx;
    font-weight: 700;
    line-height: 1.2;
}

.hero-sub {
    margin-top: var(--space-sm);
    font-size: 26rpx;
    line-height: 1.6;
    opacity: 0.78;
    margin-bottom: 36rpx;
}

/* lin-ui search-bar 外部类覆写 */
.hero-search {
    width: 100%;
}
.hero-search-container {
    padding: 0 !important;
    background: transparent !important;
}
.hero-search-input {
    height: 96rpx !important;
    border-radius: 48rpx !important;
    padding: 0 var(--space-md) !important;
    box-shadow: 0 12rpx 28rpx rgba(0, 60, 40, 0.22);
}
.hero-search-placeholder {
    color: #B5B5B5 !important;
    font-size: 28rpx !important;
}
.hero-search-icon {
    margin-right: var(--space-sm) !important;
}
.hero-search-cancel {
    color: #FFFFFF !important;
    font-size: 26rpx !important;
}

.hero-tags {
    margin-top: 28rpx;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
}
.hero-tag {
    padding: 10rpx 26rpx;
    border-radius: 999rpx;
    background-color: #FFFFFF;
    color: var(--color-primary);
    font-size: 24rpx;
    line-height: 1.5;
    font-weight: 500;
    box-shadow: 0 4rpx 10rpx rgba(0, 60, 40, 0.10);
}
.hero-tag:active {
    transform: scale(0.96);
    background-color: #F2FBF7;
}

/* ============= 合规提示条（低饱和主色提示） ============= */
.disclaimer {
    margin: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 22rpx;
    line-height: 1.6;
    border-radius: 12rpx;
    border-left: 6rpx solid var(--color-primary);
}
.disclaimer .link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
}

/* ============= 分区标题 ============= */
.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: var(--space-lg) var(--space-md) var(--space-sm);
}
.section-title {
    font-size: 30rpx;
    font-weight: 700;
    color: var(--color-text);
    position: relative;
    padding-left: 18rpx;
}
.section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8rpx;
    bottom: 8rpx;
    width: 6rpx;
    border-radius: 3rpx;
    background: var(--color-primary);
}
.section-extra {
    font-size: 22rpx;
    color: var(--color-text-3);
}

/* ============= 公司卡片（v2 三段式） ============= */
.card-wrap {
    margin: var(--space-sm) var(--space-md) 0;
    background-color: #FFFFFF;
    border-radius: 16rpx;
    padding: var(--space-md);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-hover {
    background-color: #FAFAFA;
}

/* ① head：logo + 名称 + 跳转 */
.card-head {
    display: flex;
    align-items: center;
}
.card-logo {
    width: 64rpx;
    height: 64rpx;
    border-radius: 12rpx;
    background-color: var(--color-bg-soft);
    flex-shrink: 0;
}
.card-name {
    flex: 1;
    margin: 0 var(--space-sm);
    font-size: 30rpx;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ② tags 行 */
.card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: var(--space-sm);
}

/* ③ 三列 meta */
.card-meta {
    display: flex;
    margin-top: var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1rpx solid var(--color-border);
    border-bottom: 1rpx solid var(--color-border);
}
.meta-col {
    flex: 1;
    min-width: 0;
    text-align: left;
}
.meta-col + .meta-col {
    padding-left: var(--space-sm);
    border-left: 1rpx solid var(--color-border);
    margin-left: var(--space-sm);
}
.meta-label {
    font-size: 22rpx;
    color: var(--color-text-3);
    line-height: 1.4;
}
.meta-value {
    margin-top: 6rpx;
    font-size: 26rpx;
    color: var(--color-text);
    line-height: 1.4;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ④ 地址 */
.card-addr {
    margin-top: var(--space-sm);
    font-size: 24rpx;
    color: var(--color-text-2);
    line-height: 1.6;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ============= 空态 ============= */
.empty-state {
    margin: 60rpx var(--space-md);
    padding: 80rpx var(--space-lg);
    background-color: #FFFFFF;
    border-radius: 16rpx;
    text-align: center;
}
.empty-state-title {
    font-size: 30rpx;
    color: var(--color-text);
    font-weight: 600;
}
.empty-state-tip {
    margin-top: var(--space-sm);
    font-size: 26rpx;
    color: var(--color-text-3);
    line-height: 1.6;
}
.empty-state-actions {
    margin-top: var(--space-lg);
}
.empty-state-btn {
    display: inline-block;
    padding: 16rpx 40rpx;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 999rpx;
    font-size: 26rpx;
}

/* ============= 页脚链接 ============= */
.footer-links {
    margin-top: 60rpx;
    padding: var(--space-lg) 0;
    text-align: center;
    font-size: 24rpx;
    color: var(--color-text-3);
}
.footer-links .link {
    color: var(--color-primary);
}
.footer-links .sep {
    margin: 0 var(--space-sm);
    color: var(--color-text-3);
}

/* ============= 隐私授权弹窗 ============= */
.privacy-mask {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 60rpx;
}
.privacy-modal {
    width: 100%;
    max-width: 600rpx;
    background-color: #FFFFFF;
    border-radius: 24rpx;
    padding: 48rpx 40rpx 32rpx;
    box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}
.privacy-title {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--space-md);
}
.privacy-body {
    font-size: 26rpx;
    color: var(--color-text-2);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
}
.privacy-link {
    color: var(--color-primary);
    font-weight: 600;
}
.privacy-actions {
    display: flex;
    gap: var(--space-md);
}
.privacy-btn {
    flex: 1;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 28rpx;
    border-radius: 999rpx;
    margin: 0;
    padding: 0;
    border: none;
}
.privacy-btn::after {
    border: none;
}
.privacy-btn-reject {
    background-color: var(--color-bg);
    color: var(--color-text-2);
}
.privacy-btn-agree {
    background-color: var(--color-primary);
    color: #FFFFFF;
}
.privacy-btn-agree:active {
    background-color: #0E5C44;
}

