<wxs module="tagColor">
  /**
   * 标签按"维度"返回语义化配色：
   *   status   经营状态（存续=绿，注销/吊销=灰）
   *   scale    规模/性质（蓝）
   *   risk     风险（红）—— 兼容旧 type 字符串
   */
  module.exports = {
    status: function (s) {
      if (!s) return { bg: '#F0F2F5', font: '#999999' };
      if (s === '存续' || s === '在业') return { bg: '#E8F3EF', font: '#157658' };
      return { bg: '#F0F2F5', font: '#999999' }; // 注销 / 吊销
    },
    scale: function () {
      return { bg: '#ECF0FA', font: '#3963BC' };
    },
    risk: function () {
      return { bg: '#FDECEC', font: '#D94F4F' };
    },
    // 公司名超长省略（保留前 N 个字符 + …）
    ellipsis: function (s, n) {
      if (!s) return '';
      n = n || 14;
      return s.length > n ? s.substr(0, n) + '...' : s;
    }
  }
</wxs>

<view class="container">
  <!-- Hero 顶部品牌区 -->
  <view class="hero">
    <view class="hero-brand">面试准备盒</view>
    <view class="hero-title">面试前，准备一下</view>
    <view class="hero-sub">基于公开信息与可核验事实，提前看清这家公司的背景</view>

    <l-search-bar class="hero-search"
                  l-container-class="hero-search-container"
                  l-class="hero-search-input"
                  l-placeholder-class="hero-search-placeholder"
                  l-icon-class="hero-search-icon"
                  l-cancel-class="hero-search-cancel"
                  placeholder="输入公司名称、机构、关键词"
                  icon-size="36"
                  icon-color="#157658"
                  bg-color="#FFFFFF"
                  shape="circle"
                  show-cancel="{{false}}"
                  bind:linconfirm="onSearchConfirm">
    </l-search-bar>

    <!-- 热门分类标签 -->
    <view class="hero-tags">
      <view class="hero-tag" data-kw="劳动争议" bindtap="onTagTap">劳动争议</view>
      <view class="hero-tag" data-kw="行政处罚" bindtap="onTagTap">行政处罚</view>
      <view class="hero-tag" data-kw="失信被执行" bindtap="onTagTap">失信被执行</view>
      <view class="hero-tag" data-kw="招聘风险线索" bindtap="onTagTap">招聘风险线索</view>
    </view>
  </view>

  <!-- 合规提示条 -->
  <view class="disclaimer">
    面试准备盒 · PrepBox：平台内容仅作面试、求职参考，不构成对企业的最终定性；企业状态和争议记录请以官方最新公示为准。发现失实可 <text class="link" bindtap="goAppeal">申诉、反馈</text>。
  </view>

  <!-- 分区标题 -->
  <view class="section-header">
    <view class="section-title">{{isSearch ? '搜索结果' : '热门企业'}}</view>
    <view class="section-extra">仅供参考</view>
  </view>

  <!-- 公司卡片列表 -->
  <block wx:for="{{companyData}}" wx:key="id">
    <view class="card-wrap" data-id="{{item.id}}" bindtap="goDetail" hover-class="card-hover">

      <!-- ① 顶部：Logo + 公司名（省略） + 跳转箭头 -->
      <view class="card-head">
        <image class="card-logo" src="{{item.logo}}" mode="aspectFill" />
        <view class="card-name">{{tagColor.ellipsis(item.name, 16)}}</view>
        <l-icon name="right" size="28" color="#999999" />
      </view>

      <!-- ② 标签行：状态 + 规模 + 风险（按维度配色） -->
      <view class="card-tags">
        <l-tag wx:if="{{item.status}}"
               shape="circle"
               size="small"
               bg-color="{{tagColor.status(item.status).bg}}"
               font-color="{{tagColor.status(item.status).font}}">{{item.status}}</l-tag>

        <l-tag wx:for="{{item.scaleTags}}" wx:for-item="t" wx:key="*this"
               shape="circle"
               size="small"
               bg-color="{{tagColor.scale().bg}}"
               font-color="{{tagColor.scale().font}}">{{t}}</l-tag>

        <l-tag wx:for="{{item.riskTags}}" wx:for-item="r" wx:key="label"
               shape="circle"
               size="small"
               bg-color="{{tagColor.risk().bg}}"
               font-color="{{tagColor.risk().font}}">{{r.label}}</l-tag>
      </view>

      <!-- ③ 三列工商信息：法人 / 注册资本 / 成立日期 -->
      <view class="card-meta">
        <view class="meta-col">
          <view class="meta-label">法定代表人</view>
          <view class="meta-value">{{item.legalRepresentative}}</view>
        </view>
        <view class="meta-col">
          <view class="meta-label">注册资本</view>
          <view class="meta-value">{{item.registeredCapital}}</view>
        </view>
        <view class="meta-col">
          <view class="meta-label">成立日期</view>
          <view class="meta-value">{{item.establishDate}}</view>
        </view>
      </view>

      <!-- ④ 地址（省/市/区） -->
      <view class="card-addr">
        地址：{{item.province}}{{item.city ? ' / ' + item.city : ''}}{{item.district ? ' / ' + item.district : ''}}
      </view>
    </view>
  </block>

  <!-- 空态：无搜索结果 -->
  <view class="empty-state" wx:if="{{companyData.length === 0}}">
    <view class="empty-state-title">{{isSearch ? '没有找到相关企业' : '暂无企业数据'}}</view>
    <view class="empty-state-tip" wx:if="{{isSearch}}">换个关键词试试，或者通过下方入口反馈线索</view>
    <view class="empty-state-actions" wx:if="{{isSearch}}">
      <view class="empty-state-btn" bindtap="goAppeal">提交线索 / 反馈</view>
    </view>
  </view>

  <!-- 页脚链接 -->
  <view class="footer-links">
    <text class="link" bindtap="goNotice">投稿须知</text>
    <text class="sep">·</text>
    <text class="link" bindtap="goPrivacy">隐私政策</text>
    <text class="sep">·</text>
    <text class="link" bindtap="goAppeal">申诉 / 反馈</text>
  </view>
</view>

<!-- ============= 隐私授权弹窗（基础库 >= 2.32.3） ============= -->
<view class="privacy-mask" wx:if="{{showPrivacy}}" catchtouchmove="">
  <view class="privacy-modal">
    <view class="privacy-title">用户隐私保护提示</view>
    <view class="privacy-body">
      感谢您使用「面试准备盒 · PrepBox」。我们非常重视您的个人信息和隐私保护，
      为更好地保障您的权益，请您仔细阅读
      <text class="privacy-link" bindtap="goPrivacyDetail">{{privacyContractName}}</text>
      的全部内容。点击"同意"即代表您已阅读并接受全部条款。
    </view>
    <view class="privacy-actions">
      <button class="privacy-btn privacy-btn-reject" bindtap="onRejectPrivacy">拒绝</button>
      <button class="privacy-btn privacy-btn-agree"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onAgreePrivacy">同意</button>
    </view>
  </view>
</view>
