<wxs module="tagColor">
  module.exports = {
    status: function (s) {
      if (!s) return { bg: '#F0F2F5', font: '#999999' };
      if (s === '存续') return { bg: '#E8F3EF', font: '#157658' };
      if (s === '在业') return { bg: '#E8F3EF', font: '#157658' };
      return { bg: '#F0F2F5', font: '#999999' };
    },
    scale: function () { return { bg: '#ECF0FA', font: '#3963BC' }; },
    risk:  function () { return { bg: '#FDECEC', font: '#D94F4F' }; }
  }
</wxs>

<view class="d-container" wx:if="{{company}}">

  <!-- ====== Header：Logo + 公司名 + 信用代码 + 标签 ====== -->
  <view class="d-header">
    <view class="d-header-top">
      <image class="d-logo" src="{{company.logo}}" mode="aspectFill" />
      <view class="d-header-main">
        <view class="d-name">{{company.name}}</view>
        <view class="d-code" wx:if="{{company.socialCreditCode}}" bindtap="copyCode">
          <text>统一社会信用代码：{{company.socialCreditCode}}</text>
          <text class="d-copy-btn">复制</text>
        </view>
      </view>
    </view>

    <view class="d-tags">
      <l-tag wx:if="{{company.status}}"
             shape="circle" size="mini"
             bg-color="{{tagColor.status(company.status).bg}}"
             font-color="{{tagColor.status(company.status).font}}">{{company.status}}</l-tag>
      <l-tag wx:for="{{company.scaleTags}}" wx:for-item="t" wx:key="*this"
             shape="circle" size="mini"
             bg-color="{{tagColor.scale().bg}}"
             font-color="{{tagColor.scale().font}}">{{t}}</l-tag>
      <l-tag wx:for="{{company.riskTags}}" wx:for-item="r" wx:key="label"
             shape="circle" size="mini"
             bg-color="{{tagColor.risk().bg}}"
             font-color="{{tagColor.risk().font}}">{{r.label}}</l-tag>
    </view>

    <view class="d-legal-tip">
      本页信息基于公开来源或用户提交材料整理，仅供求职前背景参考，不代表平台对企业作出最终定性；企业状态、司法/行政记录请以官方最新公示为准。
    </view>
  </view>

  <!-- ====== Tab 切换 ====== -->
  <l-segment active-key="{{activeKey}}" bind:linchange="onTabChange">
    <l-segment-item key="0" tab="基本信息" />
    <l-segment-item key="1" tab="薪资" />
    <l-segment-item key="2" tab="点评" />
  </l-segment>

  <!-- ============ 基本信息 ============ -->
  <view class="d-panel" hidden="{{activeTab !== 0}}">
    <view class="info-row">
      <view class="info-label">法定代表人</view>
      <view class="info-value">{{company.legalRepresentative || '—'}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">注册资本</view>
      <view class="info-value">{{company.registeredCapital || '—'}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">成立日期</view>
      <view class="info-value">{{company.establishDate || '—'}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">经营状态</view>
      <view class="info-value">{{company.status || '—'}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">所在地区</view>
      <view class="info-value">{{company.province}}{{company.city ? ' / ' + company.city : ''}}{{company.district ? ' / ' + company.district : ''}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">详细地址</view>
      <view class="info-value">{{company.address || '—'}}</view>
    </view>
    <view class="info-row" wx:if="{{company.remark}}">
      <view class="info-label">备注说明</view>
      <view class="info-value">{{company.remark}}</view>
    </view>

    <!-- 风险信息折叠到基本信息底部 -->
    <view class="sub-section" wx:if="{{company.riskTags && company.riskTags.length}}">
      <view class="sub-title">风险提示</view>
      <view class="risk-card" wx:for="{{company.riskTags}}" wx:for-item="r" wx:key="label">
        <view class="risk-head">
          <l-tag shape="circle" size="mini"
                 bg-color="{{tagColor.risk().bg}}"
                 font-color="{{tagColor.risk().font}}">{{r.label}}</l-tag>
          <text class="risk-date" wx:if="{{r.date}}">{{r.date}}</text>
        </view>
        <view class="risk-source" wx:if="{{r.source}}">来源：{{r.source}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 薪资 ============ -->
  <view class="d-panel" hidden="{{activeTab !== 1}}">
    <block wx:if="{{salary.total > 0}}">
      <!-- 薪资概览：平均月薪 + 样本数 -->
      <view class="sal-overview">
        <view class="sal-overview-main">
          <view class="sal-amount">
            <text class="sal-amount-num">{{salary.avg}}</text>
            <text class="sal-amount-unit">元/月</text>
          </view>
          <view class="sal-overview-sub">平均月薪 · 来自 {{salary.total}} 条经审核样本</view>
        </view>
        <view class="sal-range">
          <text class="sal-range-low">{{salary.min}}</text>
          <view class="sal-range-bar">
            <view class="sal-range-bar-inner"></view>
            <view class="sal-range-indicator" style="left: {{salary.avgPercent}}%"></view>
          </view>
          <text class="sal-range-high">{{salary.max}}</text>
        </view>
      </view>

      <!-- 按岗位汇总 -->
      <view class="sub-section">
        <view class="sub-title">按岗位汇总</view>
        <view class="sal-job-row" wx:for="{{salary.byJob}}" wx:for-item="j" wx:key="title">
          <view class="sal-job-info">
            <view class="sal-job-title">{{j.title}}</view>
            <view class="sal-job-meta">{{j.count}} 条样本</view>
          </view>
          <view class="sal-job-amount">
            <text class="sal-job-num">{{j.avg}}</text>
            <text class="sal-job-unit">元/月</text>
          </view>
        </view>
      </view>

      <!-- 最近薪资爆料 -->
      <view class="sub-section">
        <view class="sub-title">最近薪资样本</view>
        <view class="section-tip">薪资内容来自用户主动提交并经基础审核的样本，仅反映提交时点信息，不构成对实际薪酬的承诺或保证。</view>
        <view class="sal-item" wx:for="{{salary.list}}" wx:for-item="s" wx:key="id">
          <view class="sal-item-head">
            <text class="sal-item-title">{{s.title}}</text>
            <text class="sal-item-amount">{{s.amount}} 元/月</text>
          </view>
          <view class="sal-item-meta">
            <text>{{s.workYear}}</text>
            <text class="sal-dot">·</text>
            <text>{{s.city}}</text>
            <text class="sal-dot">·</text>
            <text>{{s.date}}</text>
          </view>
          <view class="sal-item-extra" wx:if="{{s.extra}}">{{s.extra}}</view>
        </view>
      </view>
    </block>
    <view class="d-empty" wx:else>
      暂无薪资数据
      <view class="d-empty-tip">可提交可核验、已脱敏的薪资样本，帮助更多求职者参考</view>
    </view>

    <view class="sal-cta">
      <l-button type="primary" plain="{{true}}" size="medium" bind:lintap="goContributeSalary">爆料我的薪资</l-button>
    </view>
  </view>

  <!-- ============ 点评 ============ -->
  <view class="d-panel" hidden="{{activeTab !== 2}}">
    <block wx:if="{{review.total > 0}}">
      <!-- 评分概览 -->
      <view class="rev-overview">
        <view class="rev-score">
          <text class="rev-score-num">{{review.avg}}</text>
          <text class="rev-score-unit">/ 5.0</text>
        </view>
        <view class="rev-score-side">
          <l-rate score="{{review.avgInt}}" disabled="{{true}}" size="24"
                  active-color="#FFDD55" inActive-color="#FFF5CE" />
          <view class="rev-score-count">{{review.total}} 条经审核点评</view>
        </view>
      </view>

      <!-- 推荐指数 -->
      <view class="rev-recommend">
        <view class="rev-recommend-num">{{review.recommendRate}}%</view>
        <view class="rev-recommend-label">推荐入职</view>
      </view>

      <!-- 维度分布 -->
      <view class="sub-section">
        <view class="sub-title">维度评分</view>
        <view class="rev-dim-row" wx:for="{{review.dimensions}}" wx:for-item="d" wx:key="label">
          <view class="rev-dim-label">{{d.label}}</view>
          <view class="rev-dim-bar">
            <view class="rev-dim-bar-inner" style="width: {{d.percent}}%"></view>
          </view>
          <view class="rev-dim-num">{{d.score}}</view>
        </view>
      </view>

      <!-- 点评列表 -->
      <view class="sub-section">
        <view class="sub-title">最新点评</view>
        <view class="section-tip">点评内容来自用户主动提交并经基础审核，不代表平台观点；涉及争议事实的，请结合公开裁判文书、行政公示或企业说明自行核验。</view>
        <l-card class="rev-card"
                wx:for="{{review.list}}" wx:for-item="r" wx:key="id"
                type="avatar"
                image="{{r.avatar || defaultAvatar}}"
                title="{{r.author}}"
                describe="{{r.position || '—'}}">
          <!-- 右上角：星级 -->
          <l-rate slot="more" score="{{r.score}}" disabled="{{true}}" size="18"
                  active-color="#FFDD55" inActive-color="#FFF5CE" />
          <!-- 主体：内容 + 标签 + 元信息 -->
          <view class="rev-card-body">
            <view class="rev-item-content {{!r.expanded ? 'rev-item-content-clamp' : ''}}">{{r.content}}</view>
            <view class="rev-item-expand" wx:if="{{r.content.length > 80}}" data-index="{{index}}" bindtap="toggleReviewExpand">
              {{r.expanded ? '收起' : '展开'}}
            </view>
            <view class="rev-item-tags" wx:if="{{r.tags && r.tags.length}}">
              <l-tag wx:for="{{r.tags}}" wx:for-item="t" wx:key="*this"
                     shape="circle" size="mini"
                     bg-color="#F0F2F5" font-color="#666666">{{t}}</l-tag>
            </view>
            <view class="rev-item-meta">
              <text>{{r.workYear}}</text>
              <text class="sal-dot">·</text>
              <text>{{r.date}}</text>
              <text class="sal-dot" wx:if="{{r.recommend}}">·</text>
              <text class="rev-recommend-mark" wx:if="{{r.recommend}}">推荐入职</text>
            </view>
          </view>
        </l-card>
      </view>
    </block>
    <view class="d-empty" wx:else>
      暂无点评
      <view class="d-empty-tip">点评需客观、脱敏，并提供可核验依据或亲历说明</view>
    </view>

    <view class="sal-cta">
      <l-button type="primary" plain="{{true}}" size="medium" bind:lintap="goContributeReview">写点评</l-button>
    </view>
  </view>

  <!-- ============ 元信息（页脚区域，常驻显示） ============ -->
  <view class="d-meta">
    <text>来源：{{company.source || '—'}}</text>
    <text class="sal-dot">·</text>
    <text>更新于 {{company.update_time || '—'}}</text>
    <text class="sal-dot">·</text>
    <text>{{company.is_real ? '来源已记录' : '待补充来源'}}</text>
  </view>

  <!-- ====== 底部申诉入口 ====== -->
  <view class="d-footer">
    <view class="d-footer-tip">信息有误？欢迎核验后申诉。</view>
    <l-button type="primary" plain="{{true}}" size="medium" bind:lintap="goAppeal">申诉 / 反馈</l-button>
  </view>
</view>

<view class="skeleton-container" wx:else>
  <view class="skeleton-header">
    <view class="skeleton-logo"></view>
    <view class="skeleton-title">
      <view class="skeleton-line" style="width: 60%;"></view>
      <view class="skeleton-line" style="width: 40%;"></view>
    </view>
  </view>
  <view class="skeleton-tabs">
    <view class="skeleton-tab"></view>
    <view class="skeleton-tab"></view>
    <view class="skeleton-tab"></view>
  </view>
  <view class="skeleton-content">
    <view class="skeleton-line" style="width: 100%;"></view>
    <view class="skeleton-line" style="width: 100%;"></view>
    <view class="skeleton-line" style="width: 80%;"></view>
  </view>
</view>

<!-- ============= 隐私授权弹窗（基础库 >= 2.32.3） ============= -->
<view class="privacy-mask" wx:if="{{showPrivacy}}" catchtouchmove="">
  <view class="privacy-modal">
    <view class="privacy-title">用户隐私保护提示</view>
    <view class="privacy-body">
      在您使用复制等功能前，需要您同意
      <text class="privacy-link" bindtap="goPrivacyDetail">{{privacyContractName}}</text>
      。点击"同意"即代表您已阅读并接受全部条款。
    </view>
    <view class="privacy-actions">
      <button class="privacy-btn privacy-btn-reject" bindtap="onRejectPrivacy">拒绝</button>
      <button class="privacy-btn privacy-btn-agree"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onAgreePrivacy">同意</button>
    </view>
  </view>
</view>
