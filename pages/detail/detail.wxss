/* pages/detail/detail.wxss */
.d-container {
    padding-bottom: 120rpx;
}

/* ===== Header ===== */
.d-header {
    background-color: #FFFFFF;
    padding: var(--space-lg) var(--space-md);
    border-bottom: 1rpx solid var(--color-border);
}
.d-header-top {
    display: flex;
    align-items: flex-start;
}
.d-logo {
    width: 96rpx;
    height: 96rpx;
    border-radius: 16rpx;
    background-color: var(--color-bg-soft);
    flex-shrink: 0;
}
.d-header-main {
    flex: 1;
    margin-left: var(--space-md);
    min-width: 0;
}
.d-name {
    font-size: 34rpx;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
}
.d-code {
    margin-top: var(--space-xs);
    font-size: 24rpx;
    color: var(--color-text-3);
    display: flex;
    align-items: center;
    gap: 8rpx;
}
.d-copy-btn {
    color: var(--color-primary);
    border: 1rpx solid var(--color-primary-light);
    background-color: var(--color-primary-light);
    border-radius: 8rpx;
    padding: 2rpx 12rpx;
    font-size: 22rpx;
}

.d-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: var(--space-md);
}
.d-legal-tip {
    margin-top: var(--space-md);
    padding: 16rpx 20rpx;
    background-color: #FFF8EC;
    border: 1rpx solid #FFE1A8;
    border-radius: 12rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #8A5A00;
}

/* ===== Panel 通用 ===== */
.d-panel {
    background-color: #FFFFFF;
    margin-top: var(--space-sm);
    padding: var(--space-md);
}

.info-row {
    display: flex;
    padding: var(--space-sm) 0;
    border-bottom: 1rpx solid var(--color-border);
    font-size: 26rpx;
    line-height: 1.6;
}
.info-row:last-child {
    border-bottom: none;
}
.info-label {
    width: 160rpx;
    color: var(--color-text-3);
    flex-shrink: 0;
}
.info-value {
    flex: 1;
    color: var(--color-text);
    word-break: break-all;
}

/* ===== 风险卡片 ===== */
.risk-card {
    padding: var(--space-sm) 0;
    border-bottom: 1rpx solid var(--color-border);
}
.risk-card:last-child {
    border-bottom: none;
}
.risk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.risk-date {
    font-size: 24rpx;
    color: var(--color-text-3);
}
.risk-source {
    margin-top: var(--space-xs);
    font-size: 24rpx;
    color: var(--color-text-2);
    line-height: 1.6;
}

.sub-section {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1rpx dashed var(--color-border);
}
.sub-title {
    font-size: 28rpx;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    padding-left: 16rpx;
    border-left: 6rpx solid var(--color-primary);
}
.section-tip {
    margin-bottom: var(--space-sm);
    padding: 12rpx 16rpx;
    background-color: var(--color-bg-soft);
    border-radius: 10rpx;
    font-size: 23rpx;
    line-height: 1.7;
    color: var(--color-text-3);
}

.d-empty {
    text-align: center;
    padding: var(--space-md) 0;
    font-size: 24rpx;
    color: var(--color-text-3);
}

/* ===== Footer ===== */
.d-footer {
    margin: var(--space-lg) var(--space-md);
    padding: var(--space-md);
    background-color: var(--color-primary-light);
    border-radius: 16rpx;
    text-align: center;
}
.d-footer-tip {
    font-size: 24rpx;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
}
/* ===== Skeleton ===== */
.skeleton-container {
    padding: var(--space-lg) var(--space-md);
    background-color: #FFFFFF;
}
.skeleton-header {
    display: flex;
    align-items: flex-start;
    margin-bottom: var(--space-xl);
}
.skeleton-logo {
    width: 96rpx;
    height: 96rpx;
    border-radius: 16rpx;
    background-color: #F0F2F5;
    flex-shrink: 0;
}
.skeleton-title {
    flex: 1;
    margin-left: var(--space-md);
}
.skeleton-line {
    height: 32rpx;
    background-color: #F0F2F5;
    border-radius: 8rpx;
    margin-bottom: 16rpx;
}
.skeleton-tabs {
    display: flex;
    margin-bottom: var(--space-lg);
    gap: 40rpx;
}
.skeleton-tab {
    width: 100rpx;
    height: 32rpx;
    background-color: #F0F2F5;
    border-radius: 8rpx;
}
.skeleton-content .skeleton-line {
    margin-bottom: 24rpx;
}
.d-loading {
    text-align: center;
    padding: 200rpx 0;
    color: var(--color-text-3);
}

/* ===== 隐私授权弹窗 ===== */
.privacy-mask {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 60rpx;
}
.privacy-modal {
    width: 100%;
    max-width: 600rpx;
    background-color: #FFFFFF;
    border-radius: 24rpx;
    padding: 48rpx 40rpx 32rpx;
    box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}
.privacy-title {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--space-md);
}
.privacy-body {
    font-size: 26rpx;
    color: var(--color-text-2);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
}
.privacy-link {
    color: var(--color-primary);
    font-weight: 600;
}
.privacy-actions {
    display: flex;
    gap: var(--space-md);
}
.privacy-btn {
    flex: 1;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 28rpx;
    border-radius: 999rpx;
    margin: 0;
    padding: 0;
    border: none;
}
.privacy-btn::after {
    border: none;
}
.privacy-btn-reject {
    background-color: var(--color-bg);
    color: var(--color-text-2);
}
.privacy-btn-agree {
    background-color: var(--color-primary);
    color: #FFFFFF;
}
.privacy-btn-agree:active {
    background-color: #0E5C44;
}

/* ===== 空态扩展 ===== */
.d-empty-tip {
    margin-top: var(--space-xs);
    font-size: 22rpx;
    color: var(--color-text-3);
}

/* ===== 薪资 ===== */
.sal-overview {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-lg) var(--space-md);
    background: linear-gradient(135deg, #FFF8EC 0%, #FFF1D6 100%);
    border-radius: 16rpx;
}
.sal-overview-main {
    text-align: center;
}
.sal-amount {
    color: #B86E00;
}
.sal-amount-num {
    font-size: 56rpx;
    font-weight: 700;
    line-height: 1.2;
}
.sal-amount-unit {
    font-size: 24rpx;
    margin-left: 6rpx;
}
.sal-overview-sub {
    margin-top: var(--space-xs);
    font-size: 24rpx;
    color: var(--color-text-3);
}
.sal-range {
    width: 100%;
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    gap: 12rpx;
    font-size: 22rpx;
    color: var(--color-text-3);
}
.sal-range-low,
.sal-range-high {
    width: 96rpx;
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.sal-range-high {
    text-align: right;
}
.sal-range-bar {
    flex: 1;
    height: 8rpx;
    background-color: rgba(184, 110, 0, 0.15);
    border-radius: 8rpx;
    position: relative;
    border-radius: 8rpx;
}
.sal-range-bar-inner {
    height: 100%;
    width: 100%;
    border-radius: 8rpx;
    background: linear-gradient(90deg, #FFD89B 0%, #B86E00 100%);
}
.sal-range-indicator {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 12rpx;
    height: 16rpx;
    background-color: #FFFFFF;
    border: 2rpx solid #B86E00;
    border-radius: 6rpx;
    box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.sal-job-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) 0;
    border-bottom: 1rpx solid var(--color-border);
}
.sal-job-row:last-child {
    border-bottom: none;
}
.sal-job-info {
    flex: 1;
    min-width: 0;
}
.sal-job-title {
    font-size: 28rpx;
    color: var(--color-text);
    font-weight: 500;
}
.sal-job-meta {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: var(--color-text-3);
}
.sal-job-amount {
    color: #B86E00;
    flex-shrink: 0;
    margin-left: var(--space-sm);
}
.sal-job-num {
    font-size: 30rpx;
    font-weight: 700;
}
.sal-job-unit {
    font-size: 22rpx;
    margin-left: 4rpx;
}

.sal-item {
    padding: var(--space-sm) 0;
    border-bottom: 1rpx solid var(--color-border);
}
.sal-item:last-child {
    border-bottom: none;
}
.sal-item-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.sal-item-title {
    font-size: 28rpx;
    color: var(--color-text);
    font-weight: 500;
}
.sal-item-amount {
    font-size: 28rpx;
    color: #B86E00;
    font-weight: 700;
}
.sal-item-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--color-text-3);
}
.sal-item-extra {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: var(--color-text-2);
    line-height: 1.6;
}
.sal-dot {
    margin: 0 8rpx;
    color: var(--color-text-3);
}

.sal-cta {
    margin-top: var(--space-lg);
    text-align: center;
}

/* ===== 点评 ===== */
.rev-overview {
    display: flex;
    align-items: center;
    padding: var(--space-md);
    background-color: var(--color-bg-soft);
    border-radius: 16rpx;
}
.rev-score {
    flex-shrink: 0;
    color: var(--color-primary);
    margin-right: var(--space-lg);
    text-align: center;
}
.rev-score-num {
    font-size: 64rpx;
    font-weight: 700;
    line-height: 1.1;
}
.rev-score-unit {
    font-size: 22rpx;
    color: var(--color-text-3);
    margin-left: 4rpx;
}
.rev-score-side {
    flex: 1;
}
.rev-score-count {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--color-text-3);
}

.rev-recommend {
    margin-top: var(--space-md);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12rpx;
}
.rev-recommend-num {
    font-size: 36rpx;
    font-weight: 700;
    color: #157658;
}
.rev-recommend-label {
    font-size: 24rpx;
    color: var(--color-text-3);
}

.rev-dim-row {
    display: flex;
    align-items: center;
    padding: 12rpx 0;
    font-size: 26rpx;
}
.rev-dim-label {
    width: 140rpx;
    color: var(--color-text-2);
    flex-shrink: 0;
}
.rev-dim-bar {
    flex: 1;
    height: 12rpx;
    background-color: var(--color-bg-soft);
    border-radius: 12rpx;
    overflow: hidden;
    margin: 0 var(--space-sm);
}
.rev-dim-bar-inner {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    border-radius: 12rpx;
}
.rev-dim-num {
    width: 60rpx;
    text-align: right;
    color: var(--color-text);
    font-weight: 600;
    flex-shrink: 0;
}

.rev-item {
    padding: var(--space-md) 0;
    border-bottom: 1rpx solid var(--color-border);
}
.rev-item:last-child {
    border-bottom: none;
}

/* l-card 版点评卡片 */
.rev-card {
    margin-bottom: var(--space-md);
    background-color: #FFFFFF;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
    padding: var(--space-md);
}
.rev-card:last-child {
    margin-bottom: 0;
}
.rev-card-body {
    margin-top: var(--space-sm);
    padding-left: 88rpx; /* 与头像左对齐让出空间 */
}
.rev-recommend-mark {
    color: #157658;
    font-weight: 500;
}
.rev-item-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.rev-item-user {
    display: flex;
    align-items: center;
    gap: 12rpx;
    min-width: 0;
}
.rev-item-name {
    font-size: 28rpx;
    color: var(--color-text);
    font-weight: 500;
}
.rev-item-tag {
    font-size: 22rpx;
    color: var(--color-text-3);
    background-color: var(--color-bg-soft);
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
}
.rev-item-content {
    margin-top: var(--space-sm);
    font-size: 26rpx;
    line-height: 1.7;
    color: var(--color-text);
}
.rev-item-content-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.rev-item-expand {
    display: inline-block;
    color: var(--color-primary);
    font-size: 26rpx;
    margin-top: 8rpx;
}
.rev-item-tags {
    margin-top: var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}
.rev-item-meta {
    margin-top: var(--space-sm);
    font-size: 22rpx;
    color: var(--color-text-3);
}

/* ===== 元信息（页脚常驻） ===== */
.d-meta {
    margin: var(--space-lg) var(--space-md) 0;
    padding: var(--space-sm);
    text-align: center;
    font-size: 22rpx;
    color: var(--color-text-3);
}
