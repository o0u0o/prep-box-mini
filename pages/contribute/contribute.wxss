/* 禁止横向滚动（避免子组件内部宽度溢出导致整页可左右滑动） */
page {
    overflow-x: hidden;
}

.container {
    padding: var(--space-md);
    padding-bottom: 120rpx;
    box-sizing: border-box;
    width: 100%;
    overflow-x: hidden;
}

/* ================= 顶部提示 ================= */
.notice-bar {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    background-color: var(--color-warning-light);
    color: var(--color-warning);
    padding: var(--space-sm) var(--space-md);
    border-radius: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    margin-bottom: var(--space-md);
}
.notice-bar .notice-text { flex: 1; min-width: 0; }
.notice-bar .link {
    color: var(--color-primary);
    text-decoration: underline;
}

/* ================= 表单卡片 ================= */
.form-card {
    background-color: #FFFFFF;
    border-radius: 16rpx;
    padding: var(--space-md);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.field {
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-md) 0;
    border-bottom: 1rpx solid var(--color-border);
    display: block;
}
.field:first-child { padding-top: 0; }
.field:last-child { border-bottom: none; padding-bottom: 0; }

.field-row,
.field-block {
    display: block;
}

.field-label {
    display: block;
    width: 100%;
    font-size: 28rpx;
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 12rpx;
    text-align: left;
}
.field-label.required::before {
    content: '*';
    color: var(--color-danger);
    margin-right: 6rpx;
}

/* 控件容器（label 下方） */
.field-control {
    width: 100%;
}

/* 字符计数（放在控件下面右侧） */
.counter-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 6rpx;
}
.counter {
    font-size: 22rpx;
    color: var(--color-text-3);
}

/* 原生 input / textarea */
.native-input,
.native-textarea {
    width: 100%;
    box-sizing: border-box;
    background-color: var(--color-bg-soft);
    border-radius: 8rpx;
    padding: 16rpx 24rpx;
    font-size: 28rpx;
    color: var(--color-text);
    line-height: 1.5;
    min-height: 72rpx;
}
.native-textarea {
    min-height: 160rpx;
}
.native-placeholder {
    color: var(--color-text-3);
    font-size: 28rpx;
}

/* 错误提示放在控件下方 */
.err-tip {
    color: var(--color-danger);
    font-size: 22rpx;
    margin-top: 8rpx;
    line-height: 1.4;
}

/* ================= radio 类型 ================= */
.radio-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx 24rpx;
    padding: 8rpx 0;
}
.radio-item { display: flex; align-items: center; }
.radio-text {
    font-size: 26rpx;
    color: var(--color-text);
    margin-left: 4rpx;
}

/* ================= region picker ================= */
.picker-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 24rpx;
    background-color: var(--color-bg-soft);
    border-radius: 8rpx;
    font-size: 28rpx;
    color: var(--color-text);
    min-height: 72rpx;
    box-sizing: border-box;
    width: 100%;
}
.picker-trigger.placeholder .picker-text {
    color: var(--color-text-3);
}
.picker-text {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ================= 同意区 ================= */
.agree {
    margin-top: var(--space-md);
    display: flex;
    align-items: flex-start;
    font-size: 24rpx;
    color: var(--color-text-2);
    line-height: 1.6;
    padding: 0 var(--space-xs);
}
.agree .check {
    flex-shrink: 0;
    width: 32rpx;
    height: 32rpx;
    border: 2rpx solid var(--color-border);
    border-radius: 6rpx;
    margin-right: var(--space-sm);
    margin-top: 4rpx;
    text-align: center;
    line-height: 28rpx;
    font-size: 24rpx;
    color: #FFFFFF;
}
.agree .check.checked {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
}
.agree .agree-text { flex: 1; min-width: 0; }
.agree .link { color: var(--color-primary); }

/* ================= 提交区 ================= */
.submit {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
}
.tips {
    font-size: 24rpx;
    color: var(--color-text-3);
    text-align: center;
}

/* ================= 预览弹窗 ================= */
.preview {
    padding: var(--space-sm) 0;
    text-align: left;
    font-size: 26rpx;
    color: var(--color-text);
    line-height: 1.7;
}
.preview-row {
    margin-bottom: 12rpx;
    word-break: break-all;
}
.preview-row .k {
    color: var(--color-text-3);
    margin-right: 8rpx;
}
.preview-row .v {
    color: var(--color-text-2);
}

/* l-mask 自定义遮罩：加入毛玻璃模糊，提升弹窗聚焦感 */
.preview-mask {
    backdrop-filter: blur(6rpx);
    -webkit-backdrop-filter: blur(6rpx);
}
/* 让 l-dialog 自身背景层透明，避免与 l-mask 叠成两层灰 */
.preview-dialog-bg {
    background-color: transparent !important;
}
